+++ b/tests/test_ncu_chunked_gemm.py	2026-09-26 12:58:53.919981552 -0400
@@ -0,0 +1,14 @@
+"""A row-chunked GEMM (4 launches of one kernel per 1024-token piece) is GEMM on every launch, not 1 GEMM + 3 aux."""
+from boltbeam.profiler.ncu_counters import mark_gemm
+from boltbeam.profiler.ncu_audit import _side
+
+
+def _row(kernel, us, tp): return {"kernel": kernel, "duration_us": us, "tensor_pipe_util_pct": tp}
+
+
+def test_every_chunk_launch_is_gemm():
+  group = [_row("split", 6.0, 0.0)] + [_row("gemm512", 460.0 + i, 57.0) for i in range(4)] + [_row("concat", 150.0, 0.0)]
+  mark_gemm(group)
+  assert [r["aux"] for r in group] == [True, False, False, False, False, True]
+  side = _side(group)
+  assert side["gemm_us"] == sum(460.0 + i for i in range(4)) and side["aux_us"] == 156.0 and side["gemm_launches"] == 4
